rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = custom claim OR role field on the caller's own user document.
    // No email addresses are hardcoded — grant/revoke admin in Firestore
    // by setting users/{uid}.role to "admin" / "user".
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == "admin" ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        )
      );
    }

    // A non-admin signed-in user may only bump the entriesSold purchase
    // counter — never status, entriesClosed, winners, or lifecycle fields.
    function entriesSoldOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["entriesSold"])
        && request.resource.data.get("entriesSold", 0) >= resource.data.get("entriesSold", 0);
    }

    // Tickets may only be created while the parent competition is still
    // accepting entries. This enforces the closed state in the backend —
    // frontend timers alone are not trusted.
    function competitionAcceptingEntries(competitionId) {
      return exists(/databases/$(database)/documents/competitions/$(competitionId))
        && get(/databases/$(database)/documents/competitions/$(competitionId)).data.get("entriesClosed", false) == false
        && get(/databases/$(database)/documents/competitions/$(competitionId)).data.get("entriesPaused", false) == false
        && !(get(/databases/$(database)/documents/competitions/$(competitionId)).data.get("status", "LIVE") in ["DRAW_READY", "DRAW-READY", "DRAW_IN_PROGRESS", "WINNER_SELECTED", "COMPLETED", "CLOSED", "CANCELLED", "SUSPENDED", "REFUND_REQUIRED"]);
    }

    // Public catalog collections (readable by anyone; writes gated below)
    match /competitions/{competitionId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && entriesSoldOnly());
      allow delete: if isAdmin();

      // Individual raffle tickets — one doc per ticket number.
      // Created at purchase (authenticated, parent still open), immutable
      // afterwards except the admin draw commit (WINNER marking).
      // Reads are restricted: ticket docs carry owner contact details,
      // so only admins and the ticket owner may read them.
      match /tickets/{ticketId} {
        allow read: if request.auth != null && (isAdmin() || resource.data.get("userId", "") == request.auth.uid);
        allow create: if request.auth != null && competitionAcceptingEntries(competitionId);
        allow update: if isAdmin();
        allow delete: if false;
      }

      match /drawAudits/{auditId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Raffle draw records — public read (verification page), admin-only
    // writes. Winner selection is committed via transaction; clients can
    // never supply their own winner through these rules.
    // NOTE: a previous duplicate match block granted any authenticated user
    // write access here (last match wins) and would have allowed forged
    // winners — it has been removed.
    match /draws/{drawId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Public winners showcase — public read, admin-only writes.
    match /winners/{winnerId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Community pool stats & global settings
    match /platformSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Partner profiles (publicly viewable, editable by partner or admin)
    match /partner_profiles/{partnerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // Partner prize assets (readable publicly, manageable by partner owner or admin)
    match /partner_assets/{assetId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        isAdmin() ||
        (resource.data.partnerId != null && exists(/databases/$(database)/documents/partner_profiles/$(resource.data.partnerId)) && get(/databases/$(database)/documents/partner_profiles/$(resource.data.partnerId)).data.userId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // Transactions
    match /transactions/{txId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if isAdmin();
    }

    // Wallets
    match /wallets/{walletId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null;
    }

    // User accounts & private subcollections
    //
    // walletBalanceKobo is NEVER writable directly from any client (owner or
    // admin). Admins must not adjust wallet balances by hand — balances only
    // change through verified server-side flows (payments, entry purchases,
    // refunds), which use the Admin SDK and bypass these rules.
    function walletUnchanged() {
      return request.resource.data.get("walletBalanceKobo", null)
        == resource.data.get("walletBalanceKobo", null);
    }

    // Referral attribution and earnings are likewise server-only. Clients
    // can read their own values but never write referredBy, their code, or
    // any commission/balance counter — these only move through the Admin
    // SDK inside validated server functions (attributeReferral, the
    // commission engine in issueOrderTickets, payout settlement).
    function referralUnchanged() {
      return request.resource.data.get("referredBy", null) == resource.data.get("referredBy", null)
        && request.resource.data.get("referredByCode", null) == resource.data.get("referredByCode", null)
        && request.resource.data.get("referralCode", null) == resource.data.get("referralCode", null)
        && request.resource.data.get("referralEarningsKobo", null) == resource.data.get("referralEarningsKobo", null)
        && request.resource.data.get("referralEarnedTotalKobo", null) == resource.data.get("referralEarnedTotalKobo", null)
        && request.resource.data.get("referralPendingPayoutKobo", null) == resource.data.get("referralPendingPayoutKobo", null)
        && request.resource.data.get("referralTreeCount", null) == resource.data.get("referralTreeCount", null)
        && request.resource.data.get("inviteOpens", null) == resource.data.get("inviteOpens", null);
    }

    // CRM staff activities (call duration, outcome, notes, lead details)
    match /crm_activities/{activityId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    function crmLeadFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["leadStatus", "lastContacted", "assignedTo"]);
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if (
          (request.auth != null && (request.auth.uid == userId || isAdmin())) ||
          crmLeadFieldsOnly()
        )
        && walletUnchanged()
        && referralUnchanged();
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Wallet ledger is append-only from the server (Admin SDK bypasses
      // rules). Clients may read their own ledger but can never fabricate
      // credit/debit entries — this closes the manual-adjustment path.
      match /walletTransactions/{txId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }

      match /entries/{entryId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /notifications/{notifId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Referral commission ledger — written by the server inside the same
      // transaction that issues tickets. Owners may read their own ledger
      // (dashboard + transactions feed) but nobody can write from a client.
      match /referralCommissions/{txId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    // Referral code registry — codes appear in public invite URLs, but
    // resolution and attribution go through server functions only, so
    // clients get no read/write access here at all.
    match /referralCodes/{codeId} {
      allow read, write: if false;
    }

    // Referral payout requests — created and settled by server functions
    // (requestReferralPayout / adminSetPayoutStatus). Owners and admins may
    // read; clients can never create or mutate payout docs directly.
    match /payouts/{payoutId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Public username registry for unique username validation
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
    }

    // Email registry for unique email validation
    match /registeredEmails/{emailDoc} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if request.auth != null;
    }

    // Platform activity log — any signed-in user may append their own
    // actions; only admins (or the actor) may read.
    match /activityLogs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (isAdmin() || resource.data.actorId == request.auth.uid);
      allow update, delete: if false;
    }

    // Pending admin invites — managed by admins; the invited email may
    // read/consume its own invite on first sign-in.
    match /adminInvites/{inviteId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.email == request.auth.token.email);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.email == request.auth.token.email);
    }

    // Outbound mail queue for the Firestore "Trigger Email" extension.
    // Admins queue; the extension (Admin SDK) delivers regardless of rules.
    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // User notification feed — personal docs carry userId = owner, global
    // broadcasts carry userId == "". Owners read their own + broadcasts; only
    // admin sessions (or the Admin SDK, which bypasses rules) create docs.
    // Personal readAt updates come from the owner's bell; broadcast read
    // state lives in localStorage and never touches Firestore.
    match /notifications/{notifId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.userId == ""
            || isAdmin());
      allow create: if isAdmin();
      allow update: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Web-push device subscriptions — written only by server functions
    // (Admin SDK); clients never touch this collection directly.
    match /pushSubscriptions/{subId} {
      allow read, write: if false;
    }

    // Outbound web-push queue — stamped by the admin draw flow and drained
    // by the /api/notify-tick cron worker (Admin SDK bypasses these rules).
    match /pushOutbox/{boxId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Fraud case review states — admin only.
    match /fraudCases/{caseId} {
      allow read, write: if isAdmin();
    }
  }
}
